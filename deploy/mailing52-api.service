[Unit]
Description=Digital М52 — API рассылки
After=network.target

[Service]
Type=simple
User=mailing52
Group=mailing52
WorkingDirectory=/opt/mailing52
EnvironmentFile=/opt/mailing52/.env
Environment=HOST=127.0.0.1
Environment=PORT=3012
Environment=NODE_TLS_REJECT_UNAUTHORIZED=0
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/mailing52/server/index.mjs
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
# Baileys держит сокет + ключи; 200M мало
MemoryMax=450M

[Install]
WantedBy=multi-user.target
