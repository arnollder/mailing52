[Unit]
Description=Digital М52 — рассылка (Nuxt)
After=network.target

[Service]
Type=simple
User=mailing52
Group=mailing52
WorkingDirectory=/opt/mailing52
EnvironmentFile=/opt/mailing52/.env
ExecStart=/usr/bin/node /opt/mailing52/.output/server/index.mjs
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=400M

[Install]
WantedBy=multi-user.target
