# WhatsApp (Baileys) — РАЗНЫЕ сессии на прод и локалке
# Прод: /opt/mailing52/.wa-auth  (WA_PROFILE=prod, systemd)
# Этот ПК: .wa-auth-local       (pnpm wa:login → новый QR = 3-е linked device)
# Другой ПК: свой каталог / свой QR — не копируй папки auth между машинами
WA_PROFILE=local
WA_AUTH_DIR=.wa-auth-local
WA_DEVICE_NAME=mailing52-dev
# Вне прода коннект по умолчанию выключен; wa:login сам включает
WA_SKIP_CONNECT=1
WA_GROUP_JID=
# WA_GROUP_TITLE=
# WA_INVITE_LINK=
# WA_LOG_LEVEL=info
# WA_QR_TERMINAL=1
